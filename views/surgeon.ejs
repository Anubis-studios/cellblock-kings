<!DOCTYPE html>
<html>
<head>
  <title>The Surgeon - Cellblock Kings</title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .surgeon-layout { display: grid; grid-template-columns: 350px 1fr 300px; gap: 20px; padding: 20px; max-width: 1400px; margin: 0 auto; }
    .surgeon-panel { background: #1e1e1e; border: 2px solid #333; border-radius: 8px; padding: 20px; }
    
    /* Preview Area */
    .preview-area { text-align: center; position: relative; }
    .avatar-container { width: 300px; height: 350px; margin: 0 auto; background: #111; border: 3px solid #444; border-radius: 10px; position: relative; overflow: hidden; }
    #surgeonSvg { width: 100%; height: 100%; }
    
    /* Categories */
    .category-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 20px; }
    .cat-btn { background: #2a2a2a; border: 2px solid #444; color: #fff; padding: 12px; border-radius: 5px; cursor: pointer; font-weight: bold; text-transform: uppercase; font-size: 11px; transition: 0.2s; }
    .cat-btn:hover { border-color: #ff6b35; }
    .cat-btn.active { background: #ff6b35; border-color: #ff6b35; color: #000; }
    
    /* Items Grid */
    .items-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; max-height: 400px; overflow-y: auto; padding: 5px; }
    .item-card { background: #2a2a2a; border: 2px solid #444; border-radius: 5px; padding: 10px; cursor: pointer; text-align: center; transition: 0.2s; aspect-ratio: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; }
    .item-card:hover { border-color: #ff6b35; transform: translateY(-2px); }
    .item-card.selected { border-color: #4caf50; background: #1a2f1a; box-shadow: 0 0 10px rgba(76,175,80,0.3); }
    .item-icon { font-size: 28px; margin-bottom: 5px; }
    .item-name { font-size: 9px; color: #aaa; word-break: break-word; }
    
    /* Colors */
    .color-row { display: flex; gap: 8px; margin-top: 15px; flex-wrap: wrap; justify-content: center; }
    .color-dot { width: 25px; height: 25px; border-radius: 50%; border: 2px solid #555; cursor: pointer; transition: 0.2s; }
    .color-dot:hover { transform: scale(1.2); }
    .color-dot.active { border-color: #fff; box-shadow: 0 0 8px #fff; }
    
    /* Presets & Actions */
    .preset-row { display: flex; gap: 10px; margin-bottom: 15px; }
    .preset-slot { flex: 1; background: #111; border: 2px solid #444; border-radius: 5px; padding: 10px; text-align: center; cursor: pointer; font-size: 11px; color: #888; }
    .preset-slot.active { border-color: #4caf50; color: #4caf50; }
    
    .action-row { display: flex; gap: 10px; margin-top: 15px; }
    .action-btn { flex: 1; padding: 12px; border: none; border-radius: 5px; font-weight: bold; cursor: pointer; text-transform: uppercase; font-size: 12px; }
    .btn-save { background: #4caf50; color: #fff; }
    .btn-random { background: #ff9800; color: #fff; }
    .btn-reset { background: #f44336; color: #fff; }
    
    /* Packages */
    .pkg-card { background: #111; border: 1px solid #333; border-radius: 5px; padding: 12px; margin-bottom: 10px; display: flex; justify-content: space-between; align-items: center; }
    .pkg-info h4 { color: #ff6b35; margin: 0 0 5px 0; font-size: 13px; }
    .pkg-info p { color: #888; margin: 0; font-size: 10px; }
    .pkg-btn { background: #333; color: #fff; border: none; padding: 8px 12px; border-radius: 3px; cursor: pointer; font-size: 11px; }
    .pkg-btn:hover { background: #4caf50; }
    .pkg-btn.owned { background: #2e7d32; cursor: default; }
  </style>
</head>
<body>
  <div class="surgeon-layout">
    <!-- Left: Preview & Presets -->
    <div class="surgeon-panel preview-area">
      <h3 style="color:#ff6b35; margin-bottom:15px; text-transform:uppercase;">Saved Presets</h3>
      <div class="preset-row">
        <% for(let i=0; i<4; i++) { %>
          <div class="preset-slot <%= character.presets && character.presets[i] ? 'active' : '' %>" onclick="loadPreset(<%= i %>)">
            Slot <%= i+1 %>
          </div>
        <% } %>
      </div>
      
      <div class="avatar-container">
        <svg id="surgeonSvg" viewBox="0 0 200 240" xmlns="http://www.w3.org/2000/svg">
          <!-- Base Head -->
          <ellipse cx="100" cy="100" rx="60" ry="75" fill="#d2a679" id="svg-head" stroke="#000" stroke-width="2"/>
          <!-- Neck -->
          <rect x="80" y="160" width="40" height="40" fill="#d2a679" id="svg-neck" stroke="#000" stroke-width="2"/>
          <!-- Eyes -->
          <g id="svg-eyes"></g>
          <!-- Eyebrows -->
          <g id="svg-eyebrows"></g>
          <!-- Mouth -->
          <g id="svg-mouth"></g>
          <!-- Nose -->
          <path d="M 95 110 L 100 125 L 105 110" fill="none" stroke="#00000044" stroke-width="2" id="svg-nose"/>
          <!-- Tattoos/Features/Extras layer -->
          <g id="svg-layers"></g>
          <!-- Hair -->
          <g id="svg-hair"></g>
          <!-- Hats -->
          <g id="svg-hats"></g>
          <!-- Eyewear -->
          <g id="svg-eyewear"></g>
        </svg>
      </div>
      
      <div class="action-row">
        <button class="action-btn btn-reset" onclick="resetChar()">Reset</button>
        <button class="action-btn btn-random" onclick="randomize()">Random</button>
        <button class="action-btn btn-save" onclick="saveChar()">Save</button>
      </div>
      
      <div style="margin-top:20px; text-align:left;">
        <h4 style="color:#fff; font-size:12px; margin-bottom:10px;">Color Picker</h4>
        <div class="color-row" id="colorRow">
          <div class="color-dot" style="background:#000000" onclick="setColor('#000000')"></div>
          <div class="color-dot" style="background:#8b0000" onclick="setColor('#8b0000')"></div>
          <div class="color-dot" style="background:#ff0000" onclick="setColor('#ff0000')"></div>
          <div class="color-dot" style="background:#ff6600" onclick="setColor('#ff6600')"></div>
          <div class="color-dot" style="background:#ffcc00" onclick="setColor('#ffcc00')"></div>
          <div class="color-dot" style="background:#00ff00" onclick="setColor('#00ff00')"></div>
          <div class="color-dot" style="background:#0066ff" onclick="setColor('#0066ff')"></div>
          <div class="color-dot" style="background:#ffffff" onclick="setColor('#ffffff')"></div>
          <div class="color-dot" style="background:#8b4513" onclick="setColor('#8b4513')"></div>
          <input type="color" id="customColor" value="#000000" onchange="setColor(this.value)" style="width:30px; height:30px; border:none; border-radius:50%; cursor:pointer;">
        </div>
      </div>
    </div>

    <!-- Center: Categories & Items -->
    <div class="surgeon-panel">
      <h3 style="color:#fff; margin-bottom:15px; text-transform:uppercase;">Customization</h3>
      <div class="category-grid" id="categoryGrid">
        <button class="cat-btn active" onclick="selectCat('heads')">Heads</button>
        <button class="cat-btn" onclick="selectCat('tattoos')">Tattoos</button>
        <button class="cat-btn" onclick="selectCat('features')">Features</button>
        <button class="cat-btn" onclick="selectCat('mouth')">Mouth</button>
        <button class="cat-btn" onclick="selectCat('eyes')">Eyes</button>
        <button class="cat-btn" onclick="selectCat('eyebrows')">Brows</button>
        <button class="cat-btn" onclick="selectCat('eyewear')">Eyewear</button>
        <button class="cat-btn" onclick="selectCat('extras')">Extras</button>
        <button class="cat-btn" onclick="selectCat('hair')">Hair</button>
        <button class="cat-btn" onclick="selectCat('hats')">Hats</button>
      </div>
      
      <div class="items-grid" id="itemsGrid">
        <!-- Items injected via JS -->
      </div>
    </div>

    <!-- Right: Packages -->
    <div class="surgeon-panel">
      <h3 style="color:#ff6b35; margin-bottom:15px; text-transform:uppercase;">Surgeon Packs</h3>
      <p style="color:#888; font-size:11px; margin-bottom:15px;">Your Favors: <strong style="color:#4caf50;"><%= user.favors || 0 %></strong></p>
      <div id="packagesList">
        <% packages.forEach(pkg => { 
          const owned = (user.character?.unlockedPackages || ['default']).includes(pkg.id);
        %>
          <div class="pkg-card">
            <div class="pkg-info">
              <h4><%= pkg.name %></h4>
              <p><%= pkg.description %></p>
              <p style="color:#ffd700; margin-top:5px;"><%= pkg.cost %> Favors</p>
            </div>
            <button class="pkg-btn <%= owned ? 'owned' : '' %>" onclick="buyPkg('<%= pkg.id %>')" <%= owned ? 'disabled' : '' %>>
              <%= owned ? 'OWNED' : 'BUY' %>
            </button>
          </div>
        <% }); %>
      </div>
      <div style="margin-top:20px; text-align:center;">
        <a href="/premium" class="btn btn-primary" style="text-decoration:none; display:inline-block; padding:10px 20px;">💳 Buy Favors with Cash</a>
      </div>
    </div>
  </div>

  <script>
    // Pass data from server to client
    const allItems = <%- items %>;
    let charConfig = <%- JSON.stringify(character || { layers: {}, colors: {} }) %>;
    let currentCat = 'heads';
    let currentColor = '#000000';
    
    // Ensure layers object exists
    if (!charConfig.layers) charConfig.layers = {};
    if (!charConfig.colors) charConfig.colors = {};

    const icons = { heads: '👤', tattoos: '🎨', features: '✨', mouth: '👄', eyes: '👁️', eyebrows: '〰️', eyewear: '👓', extras: '🎁', hair: '💇', hats: '🎩' };

    function init() {
      loadItems();
      renderSvg();
    }

    function selectCat(cat) {
      currentCat = cat;
      document.querySelectorAll('.cat-btn').forEach(b => b.classList.remove('active'));
      event.target.classList.add('active');
      loadItems();
    }

    function loadItems() {
      const grid = document.getElementById('itemsGrid');
      const items = allItems.filter(i => i.category === currentCat);
      
      if (items.length === 0) {
        grid.innerHTML = '<p style="color:#888; grid-column:1/-1; text-align:center;">No items in this category yet.</p>';
        return;
      }

      grid.innerHTML = items.map(item => {
        const isSelected = charConfig.layers[currentCat] && charConfig.layers[currentCat].includes(item.id);
        return `
          <div class="item-card ${isSelected ? 'selected' : ''}" onclick="toggleItem('${item.id}')">
            <div class="item-icon">${icons[currentCat] || '📦'}</div>
            <div class="item-name">${item.name}</div>
          </div>
        `;
      }).join('');
    }

    function toggleItem(itemId) {
      if (!charConfig.layers[currentCat]) charConfig.layers[currentCat] = [];
      const idx = charConfig.layers[currentCat].indexOf(itemId);
      
      if (idx > -1) {
        charConfig.layers[currentCat].splice(idx, 1);
        delete charConfig.colors[`${currentCat}_${itemId}`];
      } else {
        charConfig.layers[currentCat].push(itemId);
        charConfig.colors[`${currentCat}_${itemId}`] = currentColor;
      }
      
      loadItems();
      renderSvg();
      autoSave();
    }

    function setColor(color) {
      currentColor = color;
      document.querySelectorAll('.color-dot').forEach(d => d.classList.remove('active'));
      if(event && event.target.classList) event.target.classList.add('active');
      
      // Apply to last selected item in current category
      if (charConfig.layers[currentCat] && charConfig.layers[currentCat].length > 0) {
        const lastItem = charConfig.layers[currentCat][charConfig.layers[currentCat].length - 1];
        charConfig.colors[`${currentCat}_${lastItem}`] = color;
        renderSvg();
        autoSave();
      }
    }

    function renderSvg() {
      const svg = document.getElementById('surgeonSvg');
      const layersGroup = document.getElementById('svg-layers');
      const hairGroup = document.getElementById('svg-hair');
      const hatGroup = document.getElementById('svg-hats');
      const eyeGroup = document.getElementById('svg-eyes');
      const browGroup = document.getElementById('svg-eyebrows');
      const mouthGroup = document.getElementById('svg-mouth');
      const eyewearGroup = document.getElementById('svg-eyewear');
      
      // Clear dynamic groups
      layersGroup.innerHTML = ''; hairGroup.innerHTML = ''; hatGroup.innerHTML = '';
      eyeGroup.innerHTML = ''; browGroup.innerHTML = ''; mouthGroup.innerHTML = ''; eyewearGroup.innerHTML = '';

      // Render Hair
      if (charConfig.layers.hair) {
        charConfig.layers.hair.forEach(id => {
          const color = charConfig.colors[`hair_${id}`] || '#222';
          if (id.includes('mohawk')) hairGroup.innerHTML += `<path d="M 70 60 L 100 20 L 130 60 Z" fill="${color}"/>`;
          else if (id.includes('long')) hairGroup.innerHTML += `<path d="M 40 100 Q 100 20 160 100 L 160 180 L 40 180 Z" fill="${color}"/>`;
          else if (id.includes('buzz')) hairGroup.innerHTML += `<ellipse cx="100" cy="70" rx="62" ry="40" fill="${color}"/>`;
          else if (id.includes('bald')) { /* nothing */ }
          else hairGroup.innerHTML += `<ellipse cx="100" cy="60" rx="65" ry="45" fill="${color}"/>`;
        });
      }

      // Render Hats
      if (charConfig.layers.hats) {
        charConfig.layers.hats.forEach(id => {
          const color = charConfig.colors[`hats_${id}`] || '#333';
          if (id.includes('beanie')) hatGroup.innerHTML += `<path d="M 40 80 Q 100 10 160 80 L 160 100 L 40 100 Z" fill="${color}"/>`;
          else if (id.includes('cap')) hatGroup.innerHTML += `<ellipse cx="100" cy="60" rx="70" ry="30" fill="${color}"/><rect x="120" y="50" width="60" height="15" fill="${color}"/>`;
          else if (id.includes('tophat')) hatGroup.innerHTML += `<rect x="60" y="10" width="80" height="60" fill="${color}"/><rect x="40" y="70" width="120" height="15" fill="${color}"/>`;
          else if (id.includes('bandana')) hatGroup.innerHTML += `<path d="M 40 80 L 100 40 L 160 80 L 160 100 L 40 100 Z" fill="${color}"/>`;
        });
      }

      // Render Eyes
      if (charConfig.layers.eyes) {
        charConfig.layers.eyes.forEach(id => {
          const color = charConfig.colors[`eyes_${id}`] || '#fff';
          if (id.includes('angry')) eyeGroup.innerHTML += `<path d="M 60 95 L 85 105 M 140 95 L 115 105" stroke="#000" stroke-width="3"/><circle cx="75" cy="105" r="8" fill="${color}"/><circle cx="125" cy="105" r="8" fill="${color}"/>`;
          else if (id.includes('crazy')) eyeGroup.innerHTML += `<circle cx="75" cy="105" r="10" fill="${color}"/><circle cx="125" cy="105" r="6" fill="${color}"/>`;
          else eyeGroup.innerHTML += `<ellipse cx="75" cy="105" rx="12" ry="8" fill="${color}" stroke="#000" stroke-width="1"/><ellipse cx="125" cy="105" rx="12" ry="8" fill="${color}" stroke="#000" stroke-width="1"/><circle cx="75" cy="105" r="4" fill="#000"/><circle cx="125" cy="105" r="4" fill="#000"/>`;
        });
      }

      // Render Eyebrows
      if (charConfig.layers.eyebrows) {
        charConfig.layers.eyebrows.forEach(id => {
          const color = charConfig.colors[`eyebrows_${id}`] || '#000';
          if (id.includes('thick')) browGroup.innerHTML += `<path d="M 60 85 Q 75 75 90 85 M 110 85 Q 125 75 140 85" stroke="${color}" stroke-width="6" fill="none"/>`;
          else if (id.includes('thin')) browGroup.innerHTML += `<path d="M 65 90 Q 75 85 85 90 M 115 90 Q 125 85 135 90" stroke="${color}" stroke-width="2" fill="none"/>`;
          else browGroup.innerHTML += `<path d="M 60 90 Q 75 80 90 90 M 110 90 Q 125 80 140 90" stroke="${color}" stroke-width="4" fill="none"/>`;
        });
      }

      // Render Mouth
      if (charConfig.layers.mouth) {
        charConfig.layers.mouth.forEach(id => {
          const color = charConfig.colors[`mouth_${id}`] || '#000';
          if (id.includes('smirk')) mouthGroup.innerHTML += `<path d="M 80 140 Q 100 150 120 135" stroke="${color}" stroke-width="3" fill="none"/>`;
          else if (id.includes('grin')) mouthGroup.innerHTML += `<path d="M 75 135 Q 100 160 125 135 Z" fill="${color}"/>`;
          else if (id.includes('open')) mouthGroup.innerHTML += `<ellipse cx="100" cy="145" rx="15" ry="10" fill="${color}"/>`;
          else mouthGroup.innerHTML += `<path d="M 85 140 L 115 140" stroke="${color}" stroke-width="3"/>`;
        });
      }

      // Render Eyewear
      if (charConfig.layers.eyewear) {
        charConfig.layers.eyewear.forEach(id => {
          const color = charConfig.colors[`eyewear_${id}`] || '#000';
          if (id.includes('sunglasses')) eyewearGroup.innerHTML += `<rect x="55" y="95" width="35" height="20" rx="5" fill="${color}"/><rect x="110" y="95" width="35" height="20" rx="5" fill="${color}"/><line x1="90" y1="105" x2="110" y2="105" stroke="${color}" stroke-width="3"/>`;
          else if (id.includes('glasses')) eyewearGroup.innerHTML += `<circle cx="75" cy="105" r="15" fill="none" stroke="${color}" stroke-width="3"/><circle cx="125" cy="105" r="15" fill="none" stroke="${color}" stroke-width="3"/><line x1="90" y1="105" x2="110" y2="105" stroke="${color}" stroke-width="3"/>`;
          else if (id.includes('eyepatch')) eyewearGroup.innerHTML += `<circle cx="75" cy="105" r="18" fill="${color}"/><line x1="57" y1="87" x2="140" y2="60" stroke="#000" stroke-width="2"/>`;
        });
      }

      // Render Tattoos & Features (Layers)
      if (charConfig.layers.tattoos) {
        charConfig.layers.tattoos.forEach(id => {
          const color = charConfig.colors[`tattoos_${id}`] || '#000';
          if (id.includes('teardrop')) layersGroup.innerHTML += `<path d="M 70 115 Q 75 125 70 130 Q 65 125 70 115" fill="${color}"/>`;
          else if (id.includes('skull')) layersGroup.innerHTML += `<text x="100" y="80" font-size="20" fill="${color}" text-anchor="middle">💀</text>`;
          else if (id.includes('tribal')) layersGroup.innerHTML += `<path d="M 40 120 Q 60 100 80 130 T 120 110" stroke="${color}" stroke-width="4" fill="none"/>`;
          else if (id.includes('face')) layersGroup.innerHTML += `<path d="M 50 100 L 60 120 L 55 140 M 150 100 L 140 120 L 145 140" stroke="${color}" stroke-width="3" fill="none"/>`;
        });
      }
      
      if (charConfig.layers.features) {
        charConfig.layers.features.forEach(id => {
          const color = charConfig.colors[`features_${id}`] || '#8b0000';
          if (id.includes('scar')) layersGroup.innerHTML += `<line x1="60" y1="90" x2="80" y2="110" stroke="${color}" stroke-width="3"/>`;
          else if (id.includes('bruise')) layersGroup.innerHTML += `<ellipse cx="130" cy="110" rx="15" ry="10" fill="${color}" opacity="0.6"/>`;
          else if (id.includes('blood')) layersGroup.innerHTML += `<path d="M 70 105 L 70 130 M 75 105 L 75 120" stroke="${color}" stroke-width="2"/>`;
        });
      }

      if (charConfig.layers.extras) {
        charConfig.layers.extras.forEach(id => {
          const color = charConfig.colors[`extras_${id}`] || '#gold';
          if (id.includes('chain')) layersGroup.innerHTML += `<path d="M 70 170 Q 100 190 130 170" stroke="${color}" stroke-width="4" fill="none"/>`;
          else if (id.includes('bandana')) layersGroup.innerHTML += `<rect x="40" y="150" width="120" height="20" fill="${color}"/>`;
          else if (id.includes('piercing')) layersGroup.innerHTML += `<circle cx="100" cy="135" r="3" fill="#silver"/><circle cx="80" cy="145" r="2" fill="#silver"/>`;
        });
      }
    }

    function autoSave() {
      clearTimeout(window.saveTimeout);
      window.saveTimeout = setTimeout(() => {
        fetch('/api/surgeon/save', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ character: charConfig })
        });
      }, 1000);
    }

    function saveChar() {
      const slot = prompt('Save to preset slot (0-3):', '0');
      if (slot !== null && slot >= 0 && slot <= 3) {
        fetch('/api/surgeon/save-preset', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ slot: parseInt(slot), preset: charConfig })
        }).then(r => r.json()).then(d => { alert(d.msg); location.reload(); });
      }
    }

    function loadPreset(slot) {
      fetch('/api/surgeon/load-preset', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ slot })
      }).then(r => r.json()).then(d => {
        if (d.character) { charConfig = d.character; loadItems(); renderSvg(); alert('Loaded!'); }
        else alert(d.msg);
      });
    }

    function resetChar() {
      if(confirm('Reset character?')) {
        charConfig = { layers: {}, colors: {} };
        loadItems(); renderSvg(); autoSave();
      }
    }

    function randomize() {
      const cats = ['hair', 'hats', 'eyes', 'eyebrows', 'mouth', 'tattoos', 'features', 'extras', 'eyewear'];
      charConfig.layers = {};
      charConfig.colors = {};
      cats.forEach(cat => {
        const catItems = allItems.filter(i => i.category === cat);
        if (catItems.length > 0 && Math.random() > 0.4) {
          const randomItem = catItems[Math.floor(Math.random() * catItems.length)];
          charConfig.layers[cat] = [randomItem.id];
          const colors = ['#000000', '#8b0000', '#ff0000', '#ff6600', '#0066ff', '#ffffff', '#8b4513'];
          charConfig.colors[`${cat}_${randomItem.id}`] = colors[Math.floor(Math.random() * colors.length)];
        }
      });
      loadItems(); renderSvg(); autoSave();
    }

    function buyPkg(pkgId) {
      if(confirm('Buy this package with Favors?')) {
        fetch('/api/surgeon/buy-package', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ packageId: pkgId })
        }).then(r => r.json()).then(d => { alert(d.msg); if(d.msg.includes('Purchased')) location.reload(); });
      }
    }

    // Initialize
    window.onload = init;
  </script>
</body>
</html>
