<!DOCTYPE html>
<html>
<head>
  <title>Gym - Cellblock Kings</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header>
    <h1>🔒 CELLBLOCK KINGS</h1>
    <span><%= user.tag %> (Lvl <%= user.lvl %>)</span>
  </header>
  <nav>
    <a href="/home">Home</a>
    <a href="/gym">Gym</a> <a href="/market">Market</a> <a href="/inventory">Inventory</a> <a href="/inmates">Inmates</a>
    <a href="/jobs">Jobs</a> <a href="/drugs">Drugs</a> <a href="/yard">Yard</a> <a href="/logout" style="color:#ff6b35">Logout</a>
  </nav>
  <main>
    <h2>💪 Prison Gym</h2>
    <p style="color:#a0a0a0; margin-bottom:15px;">Spend 2 Energy to train a stat. Higher Stamina = better gains!</p>
    
    <div class="stats">
      <div class="stat-box">
        <span>Strength</span>
        <strong style="color:#ff6b35"><%= user.str %></strong>
      </div>
      <div class="stat-box">
        <span>Defense</span>
        <strong style="color:#2196f3"><%= user.def %></strong>
      </div>
      <div class="stat-box">
        <span>Speed</span>
        <strong style="color:#4caf50"><%= user.spd %></strong>
      </div>
      <div class="stat-box">
        <span>Energy</span>
        <strong style="color:#ffd700"><%= user.en %>/<%= user.max_en %></strong>
      </div>
    </div>
    
    <h3>Training Stations</h3>
    <button class="crime-btn" onclick="train('str')">🏋️ Weight Training (+STR)</button>
    <button class="crime-btn" onclick="train('def')">🥊 Punching Bag (+DEF)</button>
    <button class="crime-btn" onclick="train('spd')">🏃 Treadmill (+SPD)</button>
    
    <div style="margin-top:20px; padding:15px; background:#111; border-radius:5px;">
      <h4 style="color:#ff6b35; margin-bottom:10px;">📊 Level Progress</h4>
      <p>Level: <strong><%= user.lvl %></strong></p>
      <p>EXP: <strong><%= user.exp %></strong> / <strong><%= user.lvl * 100 %></strong></p>
      <div style="background:#333; height:20px; border-radius:10px; overflow:hidden; margin-top:10px;">
        <div style="background:#ffd700; height:100%; width: <%= Math.min((user.exp / (user.lvl * 100)) * 100, 100) %>%;"></div>
      </div>
    </div>
  </main>
  <script>
    function train(stat) {
      fetch('/train', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({stat: stat})
      })
      .then(r => r.json())
      .then(d => {
        alert(d.msg);
        location.reload();
      });
    }
  </script>
</body>
</html>
