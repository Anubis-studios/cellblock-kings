<!DOCTYPE html><html><head><title>Login</title><link rel="stylesheet" href="/css/style.css"></head>
<body class="auth"><div class="box"><h1>🔒 CELLBLOCK KINGS</h1>
<% if (error) { %><p class="error"><%= error %></p><% } %>
<form method="POST"><input name="tag" placeholder="Inmate Tag" required><input name="pass" type="password" placeholder="Passcode" required><button>Enter the Block</button></form>
<p class="link"><a href="/register">New Inmate? Register</a></p></div></body></html>
