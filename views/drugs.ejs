<!DOCTYPE html>
<html>
<head><title>Drugs - Cellblock Kings</title><link rel="stylesheet" href="/css/style.css"></head>
<body>
  <header><h1>🔒 CELLBLOCK KINGS</h1><span><%= user.tag %> (Lvl <%= user.lvl %>)</span></header>
  <nav><a href="/home">Home</a> <a href="/gym">Gym</a> <a href="/market">Market</a> <a href="/inventory">Inventory</a> <a href="/inmates">Inmates</a> <a href="/bank">Bank</a> <a href="/hitlist">Hitlist</a> <a href="/cell">Cell</a> <a href="/jobs">Jobs</a> <a href="/drugs">Drugs</a> <a href="/yard">Yard</a> <a href="/logout" style="color:#ff6b35">Logout</a></nav>
  <main>
    <h2>💊 The Black Market Pharmacy</h2>
    <p style="color:#ff6b35; margin-bottom:15px;">⚠️ WARNING: All drugs carry an overdose risk. Overdosing sends you to the Med Bay for 30 minutes!</p>
    <div class="inmates-list">
      <% drugs.forEach(drug => { %>
        <div class="inmate-card">
          <div class="inmate-info">
            <h4><%= drug.name %></h4>
            <p style="font-size:0.8em; color:#a0a0a0;">Effect: <%= drug.effect.toUpperCase() %> | Risk: <%= drug.overdose_chance %>%</p>
            <p style="color:#ffd700; font-weight:bold;">$<%= drug.price %></p>
          </div>
          <button class="attack-btn" style="background:#9c27b0;" onclick="buyDrug(<%= drug.id %>)">Buy & Use</button>
        </div>
      <% }) %>
    </div>
  </main>
  <script>
    function buyDrug(id) { 
      if(!confirm('Buy and use immediately? Risk of overdose!')) return;
      fetch('/buy-drug/'+id, {method:'POST'}).then(r=>r.json()).then(d=>{alert(d.msg); location.reload();}); 
    }
  </script>
</body>
</html>
