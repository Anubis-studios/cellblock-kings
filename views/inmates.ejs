<!DOCTYPE html><html><head><title>All Inmates</title><link rel="stylesheet" href="/css/style.css"></head>
<body>
  <div class="top-bar"><div class="player-info"><strong><%= user.tag %></strong></div></div>
  <div class="game-layout">
    <nav class="sidebar"><a href="/prison-hall">Prison Hall</a><a href="/crimes">Crimes</a><a href="/inmates" class="active">All Inmates</a><a href="/hitlist">Hitlist</a><a href="/inventory">Inventory</a><a href="/logout">Sign Out</a></nav>
    <main class="main-content">
      <h2 style="color:#ff6b35;">ALL INMATES</h2>
      <p style="color:#a0a0a0;margin-bottom:15px;"><%= inmates.length %> on the roster · online status updates on the tick</p>
      <div style="display:flex;gap:10px;margin-bottom:15px;">
        <input type="text" placeholder="Search Inmate Tag..." style="flex:1;max-width:300px;">
        <select onchange="location.href='/inmates?prison='+this.value+'&lvl=<%= lvlFilter %>'">
          <option value="all" <%= prisonFilter==='all'?'selected':'' %>>All prisons</option>
          <option value="ironhold" <%= prisonFilter==='ironhold'?'selected':'' %>>Ironhold</option>
          <option value="stonewall" <%= prisonFilter==='stonewall'?'selected':'' %>>Stonewall</option>
          <option value="pinecrest" <%= prisonFilter==='pinecrest'?'selected':'' %>>Pinecrest</option>
          <option value="dustbowl" <%= prisonFilter==='dustbowl'?'selected':'' %>>Dustbowl</option>
          <option value="blackridge" <%= prisonFilter==='blackridge'?'selected':'' %>>Blackridge</option>
        </select>
        <select onchange="location.href='/inmates?prison=<%= prisonFilter %>&lvl='+this.value">
          <option value="all" <%= lvlFilter==='all'?'selected':'' %>>Any level</option>
          <option value="1-5" <%= lvlFilter==='1-5'?'selected':'' %>>1-5</option>
          <option value="6-10" <%= lvlFilter==='6-10'?'selected':'' %>>6-10</option>
          <option value="11-20" <%= lvlFilter==='11-20'?'selected':'' %>>11-20</option>
          <option value="21-70" <%= lvlFilter==='21-70'?'selected':'' %>>21-70</option>
        </select>
      </div>
      <table class="data-table">
        <thead><tr><th>INMATE</th><th>LVL</th><th>PRISON</th><th>STATUS</th><th></th></tr></thead>
        <tbody>
          <% inmates.forEach(i => { %>
            <tr>
              <td><strong><%= i.tag %></strong></td>
              <td><%= i.lvl %></td>
              <td><%= i.prison || 'ironhold' %></td>
              <td><span style="color:<%= i.online ? '#4caf50' : '#a0a0a0' %>">● <%= i.online ? 'online' : 'offline' %></span></td>
              <td><button class="btn btn-small">VIEW</button></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </main>
  </div>
</body></html>
