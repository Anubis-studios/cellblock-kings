<!DOCTYPE html><html><head><title>Gym</title><link rel="stylesheet" href="/css/style.css"></head>
<body>
  <div class="top-bar"><div class="player-info"><strong><%= user.tag %></strong></div></div>
  <div class="game-layout">
    <nav class="sidebar"><a href="/prison-hall">Prison Hall</a><a href="/crimes">Crimes</a><a href="/yard">Yard</a><a href="/gym" class="active">Gym</a><a href="/jobs">Jobs Board</a><a href="/inventory">Inventory</a><a href="/logout">Sign Out</a></nav>
    <main class="main-content">
      <h2 style="color:#ff6b35;">THE GYM</h2>
      <p style="color:#a0a0a0;margin-bottom:20px;">5 NRG per session · effectiveness scales with Stamina and total stats</p>
      <div class="grid-3">
        <div class="card"><h3>STRENGTH</h3><p style="color:#a0a0a0;font-size:0.9em;">Heavy bag, barbells, bad intentions.</p><p>Base: <strong><%= user.str %></strong></p><p>Progress: <strong>0%</strong></p><button class="btn" onclick="train('str')">TRAIN - 5 NRG</button></div>
        <div class="card"><h3>DEFENSE</h3><p style="color:#a0a0a0;font-size:0.9em;">Absorb the hit. Get up again.</p><p>Base: <strong><%= user.def %></strong></p><p>Progress: <strong>0%</strong></p><button class="btn" onclick="train('def')">TRAIN - 5 NRG</button></div>
        <div class="card"><h3>SPEED</h3><p style="color:#a0a0a0;font-size:0.9em;">First to move, first to land.</p><p>Base: <strong><%= user.spd %></strong></p><p>Progress: <strong>0%</strong></p><button class="btn" onclick="train('spd')">TRAIN - 5 NRG</button></div>
      </div>
      <p style="color:#a0a0a0;margin-top:20px;">Total stats: <%= user.str + user.def + user.spd %>. Higher totals train slower — stamina keeps the gains coming.</p>
    </main>
  </div>
  <script>function train(s){fetch('/gym/train',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({stat:s})}).then(r=>r.json()).then(d=>{alert(d.msg);location.reload();});}</script>
</body></html>
