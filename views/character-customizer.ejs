<%- include('layout-header', { title: 'Character Customizer', active: 'customizer' }) %>

<style>
  .customizer-layout { display: flex; gap: 20px; padding: 20px; }
  .canvas-container { 
    flex: 1; 
    background: #1a1a1a; 
    border: 3px solid #555; 
    border-radius: 5px; 
    display: flex; 
    align-items: center; 
    justify-content: center;
    min-height: 500px;
    position: relative;
  }
  #charCanvas { background: #2a2a2a; border-radius: 3px; box-shadow: 0 0 20px rgba(0,0,0,0.5); }
  .controls-container { 
    width: 350px; 
    background: linear-gradient(180deg, #3a3a3a 0%, #2a2a2a 100%);
    border: 2px solid #555;
    border-radius: 5px;
    padding: 15px;
    max-height: 600px;
    overflow-y: auto;
  }
  .control-group { margin-bottom: 15px; border-bottom: 1px solid #444; padding-bottom: 15px; }
  .control-group label { display: block; color: #4caf50; font-weight: bold; margin-bottom: 5px; font-size: 12px; text-transform: uppercase; }
  .control-group select, .control-group input[type="color"] { 
    width: 100%; background: #1a1a1a; border: 1px solid #555; color: #fff; 
    padding: 8px; border-radius: 3px; margin-bottom: 5px;
  }
  .preset-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 15px; }
  .preset-btn { 
    background: #444; border: 2px solid #555; color: #fff; padding: 10px; 
    border-radius: 3px; cursor: pointer; font-size: 11px; text-align: center;
  }
  .preset-btn:hover { border-color: #4caf50; background: #555; }
  .preset-btn.active { border-color: #4caf50; background: #2e7d32; }
  .action-btns { display: flex; gap: 10px; margin-top: 20px; }
  .action-btns button { flex: 1; padding: 12px; font-weight: bold; }
</style>

<div class="customizer-layout">
  <div class="canvas-container">
    <canvas id="charCanvas" width="400" height="500"></canvas>
  </div>
  
  <div class="controls-container">
    <h3 style="color:#fff; margin-bottom:15px; border-bottom:2px solid #4caf50; padding-bottom:5px;">🎨 Customize Inmate</h3>
    
    <div class="control-group">
      <label>Gender</label>
      <select id="cfg-gender" onchange="updateConfig('gender', this.value)">
        <option value="male">Male</option>
        <option value="female">Female</option>
      </select>
    </div>

    <div class="control-group">
      <label>Skin Tone</label>
      <input type="color" id="cfg-skinColor" value="<%= config.skinColor || '#d2a679' %>" onchange="updateConfig('skinColor', this.value)">
    </div>

    <div class="control-group">
      <label>Hair Style</label>
      <select id="cfg-hair-style" onchange="updateNestedConfig('hair', 'style', this.value)">
        <option value="buzz">Buzz Cut</option>
        <option value="mohawk">Mohawk</option>
        <option value="long">Long & Messy</option>
        <option value="bald">Bald</option>
      </select>
      <label>Hair Color</label>
      <input type="color" id="cfg-hair-color" value="<%= config.hair?.color || '#222222' %>" onchange="updateNestedConfig('hair', 'color', this.value)">
    </div>

    <div class="control-group">
      <label>Facial Hair</label>
      <select id="cfg-facial_hair-style" onchange="updateNestedConfig('facial_hair', 'style', this.value)">
        <option value="none">Clean Shaven</option>
        <option value="goatee">Goatee</option>
        <option value="beard">Full Beard</option>
        <option value="stubble">Stubble</option>
      </select>
      <label>Facial Hair Color</label>
      <input type="color" id="cfg-facial_hair-color" value="<%= config.facial_hair?.color || '#222222' %>" onchange="updateNestedConfig('facial_hair', 'color', this.value)">
    </div>

    <div class="control-group">
      <label>Scars</label>
      <select id="cfg-scar-style" onchange="updateNestedConfig('scar', 'style', this.value)">
        <option value="none">None</option>
        <option value="eye">Over Eye</option>
        <option value="cheek">Cheek Slash</option>
        <option value="lip">Split Lip</option>
      </select>
    </div>

    <div class="control-group">
      <label>Tattoos</label>
      <select id="cfg-tattoo-style" onchange="updateNestedConfig('tattoo', 'style', this.value)">
        <option value="none">None</option>
        <option value="teardrop">Teardrop</option>
        <option value="forehead">Forehead Script</option>
        <option value="neck">Neck Spiderweb</option>
      </select>
      <label>Tattoo Color</label>
      <input type="color" id="cfg-tattoo-color" value="<%= config.tattoo?.color || '#000000' %>" onchange="updateNestedConfig('tattoo', 'color', this.value)">
    </div>

    <div class="control-group">
      <label>Headwear</label>
      <select id="cfg-hat-style" onchange="updateNestedConfig('hat', 'style', this.value)">
        <option value="none">None</option>
        <option value="beanie">Prison Beanie</option>
        <option value="bandana">Bandana</option>
        <option value="cap">Backward Cap</option>
      </select>
      <label>Headwear Color</label>
      <input type="color" id="cfg-hat-color" value="<%= config.hat?.color || '#333333' %>" onchange="updateNestedConfig('hat', 'color', this.value)">
    </div>

    <div class="action-btns">
      <button class="btn btn-primary" onclick="saveCharacter()">💾 SAVE LOOK</button>
      <button class="btn" onclick="randomize()">🎲 RANDOM</button>
    </div>

    <h4 style="color:#fff; margin:20px 0 10px; font-size:12px; text-transform:uppercase;">Saved Presets</h4>
    <div class="preset-grid">
      <% for (let i = 0; i < 4; i++) { %>
        <button class="preset-btn" onclick="loadPreset(<%= i %>)" id="preset-btn-<%= i %>">
          <%= user.saved_presets && user.saved_presets[i] ? user.saved_presets[i].name : 'Empty Slot ' + (i+1) %>
        </button>
      <% } %>
    </div>
    <div style="margin-top:10px; display:flex; gap:5px;">
      <input type="text" id="preset-name" placeholder="Preset Name" style="flex:1; font-size:11px;">
      <button class="btn btn-small" onclick="savePreset()">Save to Slot</button>
    </div>
  </div>
</div>

<script>
  // Initialize config from server
  let charConfig = <%- JSON.stringify(config || {}) %>;
  let currentPresetSlot = 0;

  // Ensure defaults
  charConfig = {
    gender: charConfig.gender || 'male',
    skinColor: charConfig.skinColor || '#d2a679',
    eyes: charConfig.eyes || { style: 'normal', color: '#333333' },
    mouth: charConfig.mouth || { style: 'neutral' },
    hair: charConfig.hair || { style: 'buzz', color: '#222222' },
    facial_hair: charConfig.facial_hair || { style: 'none', color: '#222222' },
    tattoo: charConfig.tattoo || { style: 'none', color: '#000000' },
    scar: charConfig.scar || { style: 'none', color: '#8b0000' },
    hat: charConfig.hat || { style: 'none', color: '#333333' }
  };

  // Sync UI with config
  function syncUI() {
    document.getElementById('cfg-gender').value = charConfig.gender;
    document.getElementById('cfg-skinColor').value = charConfig.skinColor;
    document.getElementById('cfg-hair-style').value = charConfig.hair.style;
    document.getElementById('cfg-hair-color').value = charConfig.hair.color;
    document.getElementById('cfg-facial_hair-style').value = charConfig.facial_hair.style;
    document.getElementById('cfg-facial_hair-color').value = charConfig.facial_hair.color;
    document.getElementById('cfg-scar-style').value = charConfig.scar.style;
    document.getElementById('cfg-tattoo-style').value = charConfig.tattoo.style;
    document.getElementById('cfg-tattoo-color').value = charConfig.tattoo.color;
    document.getElementById('cfg-hat-style').value = charConfig.hat.style;
    document.getElementById('cfg-hat-color').value = charConfig.hat.color;
  }
  syncUI();

  function updateConfig(key, value) {
    charConfig[key] = value;
    renderCharacter();
  }

  function updateNestedConfig(category, key, value) {
    if (!charConfig[category]) charConfig[category] = {};
    charConfig[category][key] = value;
    renderCharacter();
  }

  const canvas = document.getElementById('charCanvas');
  const ctx = canvas.getContext('2d');

  function renderCharacter() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    
    const cx = 200;
    const cy = 250;

    // 1. Neck
    ctx.fillStyle = charConfig.skinColor;
    ctx.fillRect(cx - 40, cy + 60, 80, 60);

    // 2. Head Base
    ctx.fillStyle = charConfig.skinColor;
    ctx.beginPath();
    if (charConfig.gender === 'male') {
      ctx.ellipse(cx, cy, 70, 90, 0, 0, Math.PI * 2);
    } else {
      ctx.ellipse(cx, cy, 65, 85, 0, 0, Math.PI * 2);
    }
    ctx.fill();
    ctx.strokeStyle = '#00000033';
    ctx.lineWidth = 2;
    ctx.stroke();

    // 3. Eyes
    ctx.fillStyle = '#ffffff';
    ctx.beginPath(); ctx.ellipse(cx - 25, cy - 10, 15, 10, 0, 0, Math.PI * 2); ctx.fill();
    ctx.beginPath(); ctx.ellipse(cx + 25, cy - 10, 15, 10, 0, 0, Math.PI * 2); ctx.fill();
    
    ctx.fillStyle = charConfig.eyes.color;
    ctx.beginPath(); ctx.arc(cx - 25, cy - 10, 6, 0, Math.PI * 2); ctx.fill();
    ctx.beginPath(); ctx.arc(cx + 25, cy - 10, 6, 0, Math.PI * 2); ctx.fill();

    // Eyebrows
    ctx.strokeStyle = charConfig.hair.color;
    ctx.lineWidth = 4;
    ctx.beginPath(); ctx.moveTo(cx - 40, cy - 30); ctx.lineTo(cx - 10, cy - 25); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(cx + 40, cy - 30); ctx.lineTo(cx + 10, cy - 25); ctx.stroke();

    // 4. Nose
    ctx.strokeStyle = '#00000044';
    ctx.lineWidth = 2;
    ctx.beginPath(); ctx.moveTo(cx, cy - 5); ctx.lineTo(cx - 5, cy + 15); ctx.lineTo(cx + 5, cy + 15); ctx.stroke();

    // 5. Mouth
    ctx.strokeStyle = '#555';
    ctx.lineWidth = 3;
    ctx.beginPath();
    if (charConfig.mouth.style === 'smirk') {
      ctx.moveTo(cx - 15, cy + 35); ctx.quadraticCurveTo(cx, cy + 45, cx + 15, cy + 35);
    } else {
      ctx.moveTo(cx - 15, cy + 40); ctx.lineTo(cx + 15, cy + 40);
    }
    ctx.stroke();

    // 6. Facial Hair
    if (charConfig.facial_hair.style !== 'none') {
      ctx.fillStyle = charConfig.facial_hair.color;
      if (charConfig.facial_hair.style === 'goatee') {
        ctx.beginPath(); ctx.ellipse(cx, cy + 55, 15, 10, 0, 0, Math.PI * 2); ctx.fill();
      } else if (charConfig.facial_hair.style === 'beard') {
        ctx.beginPath(); ctx.ellipse(cx, cy + 50, 50, 40, 0, 0, Math.PI, false); ctx.fill();
      } else if (charConfig.facial_hair.style === 'stubble') {
        ctx.fillStyle = charConfig.facial_hair.color + '66';
        ctx.beginPath(); ctx.ellipse(cx, cy + 40, 55, 45, 0, 0, Math.PI * 2); ctx.fill();
      }
    }

    // 7. Hair
    if (charConfig.hair.style !== 'bald') {
      ctx.fillStyle = charConfig.hair.color;
      ctx.beginPath();
      if (charConfig.hair.style === 'buzz') {
        ctx.ellipse(cx, cy - 30, 72, 40, 0, Math.PI, 0);
      } else if (charConfig.hair.style === 'mohawk') {
        ctx.moveTo(cx - 15, cy - 80); ctx.lineTo(cx + 15, cy - 80); ctx.lineTo(cx + 10, cy - 20); ctx.lineTo(cx - 10, cy - 20);
      } else if (charConfig.hair.style === 'long') {
        ctx.ellipse(cx, cy - 20, 75, 60, 0, Math.PI, 0);
        ctx.rect(cx - 75, cy - 20, 30, 100);
        ctx.rect(cx + 45, cy - 20, 30, 100);
      }
      ctx.fill();
    }

    // 8. Scars
    if (charConfig.scar.style !== 'none') {
      ctx.strokeStyle = charConfig.scar.color;
      ctx.lineWidth = 3;
      ctx.beginPath();
      if (charConfig.scar.style === 'eye') {
        ctx.moveTo(cx - 35, cy - 25); ctx.lineTo(cx - 15, cy - 5);
      } else if (charConfig.scar.style === 'cheek') {
        ctx.moveTo(cx + 45, cy + 10); ctx.lineTo(cx + 25, cy + 30);
      } else if (charConfig.scar.style === 'lip') {
        ctx.moveTo(cx - 5, cy + 40); ctx.lineTo(cx + 5, cy + 45);
      }
      ctx.stroke();
    }

    // 9. Tattoos
    if (charConfig.tattoo.style !== 'none') {
      ctx.fillStyle = charConfig.tattoo.color;
      ctx.font = 'bold 16px Arial';
      ctx.textAlign = 'center';
      if (charConfig.tattoo.style === 'teardrop') {
        ctx.beginPath(); ctx.ellipse(cx - 25, cy + 5, 4, 6, 0, 0, Math.PI * 2); ctx.fill();
      } else if (charConfig.tattoo.style === 'forehead') {
        ctx.fillText('XXX', cx, cy - 50);
      } else if (charConfig.tattoo.style === 'neck') {
        ctx.strokeStyle = charConfig.tattoo.color;
        ctx.lineWidth = 2;
        ctx.beginPath(); ctx.arc(cx, cy + 80, 30, 0, Math.PI, false); ctx.stroke();
        ctx.beginPath(); ctx.moveTo(cx - 15, cy + 70); ctx.lineTo(cx + 15, cy + 90); ctx.stroke();
        ctx.beginPath(); ctx.moveTo(cx + 15, cy + 70); ctx.lineTo(cx - 15, cy + 90); ctx.stroke();
      }
    }

    // 10. Hats
    if (charConfig.hat.style !== 'none') {
      ctx.fillStyle = charConfig.hat.color;
      if (charConfig.hat.style === 'beanie') {
        ctx.beginPath(); ctx.ellipse(cx, cy - 40, 75, 50, 0, Math.PI, 0); ctx.fill();
        ctx.fillRect(cx - 75, cy - 40, 150, 15);
      } else if (charConfig.hat.style === 'bandana') {
        ctx.beginPath(); ctx.moveTo(cx - 75, cy - 30); ctx.lineTo(cx, cy - 70); ctx.lineTo(cx + 75, cy - 30); ctx.fill();
        ctx.fillRect(cx - 75, cy - 30, 150, 15);
      } else if (charConfig.hat.style === 'cap') {
        ctx.beginPath(); ctx.ellipse(cx, cy - 40, 75, 40, 0, Math.PI, 0); ctx.fill();
        ctx.beginPath(); ctx.ellipse(cx + 20, cy - 30, 60, 15, 0.2, 0, Math.PI * 2); ctx.fill();
      }
    }
  }

  function saveCharacter() {
    fetch('/api/character/save', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ config: charConfig })
    }).then(r => r.json()).then(d => {
      alert(d.msg);
    });
  }

  function randomize() {
    const styles = {
      hair: ['buzz', 'mohawk', 'long', 'bald'],
      facial_hair: ['none', 'goatee', 'beard', 'stubble'],
      scar: ['none', 'eye', 'cheek', 'lip'],
      tattoo: ['none', 'teardrop', 'forehead', 'neck'],
      hat: ['none', 'beanie', 'bandana', 'cap']
    };
    
    charConfig.gender = Math.random() > 0.5 ? 'male' : 'female';
    charConfig.skinColor = '#' + Math.floor(Math.random()*16777215).toString(16).padStart(6, '0').substring(0,6);
    charConfig.hair.style = styles.hair[Math.floor(Math.random() * styles.hair.length)];
    charConfig.hair.color = '#' + Math.floor(Math.random()*16777215).toString(16).padStart(6, '0').substring(0,6);
    charConfig.facial_hair.style = styles.facial_hair[Math.floor(Math.random() * styles.facial_hair.length)];
    charConfig.scar.style = styles.scar[Math.floor(Math.random() * styles.scar.length)];
    charConfig.tattoo.style = styles.tattoo[Math.floor(Math.random() * styles.tattoo.length)];
    charConfig.tattoo.color = '#' + Math.floor(Math.random()*16777215).toString(16).padStart(6, '0').substring(0,6);
    charConfig.hat.style = styles.hat[Math.floor(Math.random() * styles.hat.length)];
    charConfig.hat.color = '#' + Math.floor(Math.random()*16777215).toString(16).padStart(6, '0').substring(0,6);
    
    syncUI();
    renderCharacter();
  }

  function savePreset() {
    const name = document.getElementById('preset-name').value || 'Preset ' + (currentPresetSlot + 1);
    fetch('/api/character/save-preset', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ slot: currentPresetSlot, config: charConfig, name: name })
    }).then(r => r.json()).then(d => {
      alert(d.msg);
      location.reload();
    });
  }

  function loadPreset(slot) {
    currentPresetSlot = slot;
    fetch('/api/character/load-preset', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ slot: slot })
    }).then(r => r.json()).then(d => {
      if (d.config) {
        charConfig = d.config;
        syncUI();
        renderCharacter();
        alert('Loaded ' + (d.config.hat?.style || 'character') + ' preset!');
      } else {
        alert(d.msg);
      }
    });
  }

  // Initial render
  renderCharacter();
</script>

<%- include('layout-footer') %>
