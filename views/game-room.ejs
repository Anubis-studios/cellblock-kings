<!DOCTYPE html><html><head><title>Game Room</title><link rel="stylesheet" href="/css/style.css"></head>
<body>
  <div class="top-bar"><div class="player-info"><strong><%= user.tag %></strong></div><div class="stat-bars"><div class="stat-bar"><span class="label">CASH</span><div class="value">$<%= user.cash %></div></div></div></div>
  <div class="game-layout">
    <nav class="sidebar"><a href="/prison-hall">Prison Hall</a><a href="/game-room" class="active">Game Room</a><a href="/logout">Sign Out</a></nav>
    <main class="main-content">
      <h2 style="color:#ff6b35;">GAME ROOM</h2>
      <p style="color:#a0a0a0;margin-bottom:20px;">Cash only · 10% house tax on winnings</p>
      <div class="tabs" id="gameTabs">
        <button class="tab active" onclick="showGame('blackjack')">BLACKJACK (100 plays)</button>
        <button class="tab" onclick="showGame('highlow')">HIGH OR LOW (200 plays)</button>
        <button class="tab" onclick="showGame('rps')">ROCK-PAPER-SCISSORS (100 plays)</button>
        <button class="tab" onclick="showGame('hex')">HEX-MATCH (100 plays)</button>
        <button class="tab" onclick="showGame('pockets')">PRISON POCKETS (100 plays)</button>
        <button class="tab" onclick="showGame('hockey')">RAZOR HOCKEY (100 plays)</button>
      </div>
      <div class="card" id="gameArea">
        <p>Select a game to play. Bet $100 minimum.</p>
        <input type="number" id="betAmount" value="100" placeholder="Bet amount">
        <button class="btn" onclick="playGame()">ROLL / DEAL</button>
      </div>
    </main>
  </div>
  <script>
    let currentGame = 'blackjack';
    function showGame(g) { currentGame = g; document.querySelectorAll('.tab').forEach(t => t.classList.remove('active')); event.target.classList.add('active'); }
    function playGame() { const bet = document.getElementById('betAmount').value; fetch('/minigame/'+currentGame,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({bet})}).then(r=>r.json()).then(d=>{alert(d.msg);location.reload();}); }
  </script>
</body></html>
