<!DOCTYPE html><html><head><title>Login</title><link rel="stylesheet" href="/css/style.css"></head>
<body class="auth-page">
  <div class="auth-box">
    <h1>🔒 CELLBLOCK KINGS</h1>
    <% if (error) { %><p style="color:#f44336;text-align:center;"><%= error %></p><% } %>
    <form method="POST">
      <input name="tag" placeholder="Inmate Tag" required>
      <input name="pass" type="password" placeholder="Passcode" required>
      <button class="btn btn-primary" style="width:100%;">ENTER THE BLOCK</button>
    </form>
    <p style="text-align:center;margin-top:15px;"><a href="/register" style="color:#4caf50;">New Inmate? Register</a></p>
  </div>
</body></html>
