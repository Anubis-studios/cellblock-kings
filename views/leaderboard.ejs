<!DOCTYPE html><html><head><title>Leaderboard</title><link rel="stylesheet" href="/css/style.css"></head>
<body>
  <header><h1>🔒 CELLBLOCK KINGS</h1><span><%= user.tag %></span></header>
  <nav><a href="/home">Home</a> <a href="/chat">Chat</a> <a href="/leaderboard">Top 10</a> <a href="/logout" style="color:#ff6b35">Logout</a></nav>
  <main>
    <h2>🏆 Top 10 Kingpins</h2>
    <div class="inmates-list">
      <% top.forEach((p, i) => { %>
        <div class="inmate-card">
          <div class="inmate-info">
            <h4>#<%= i+1 %> <%= p.tag %> <span style="color:#ffd700;">(Lvl <%= p.lvl %>)</span></h4>
            <p>EXP: <%= p.exp %></p>
          </div>
        </div>
      <% }) %>
    </div>
  </main>
</body></html>
