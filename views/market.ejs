<!DOCTYPE html><html><head><title>Market</title><link rel="stylesheet" href="/css/style.css"></head>
<body>
  <div class="top-bar"><div class="player-info"><strong><%= user.tag %></strong></div><div class="stat-bars"><div class="stat-bar"><span class="label">CASH</span><div class="value">$<%= user.cash %></div></div></div></div>
  <div class="game-layout">
    <nav class="sidebar"><a href="/prison-hall">Prison Hall</a><a href="/inventory">Inventory</a><a href="/market" class="active">Market</a><a href="/bank">Bank</a><a href="/logout">Sign Out</a></nav>
    <main class="main-content">
      <h2 style="color:#ff6b35;">MARKET</h2>
      <p style="color:#a0a0a0;margin-bottom:15px;">Ironhold prices · VIP gets 20% off</p>
      <div class="tabs">
        <a href="/market?cat=all" class="tab <%= category==='all'?'active':'' %>">All</a>
        <a href="/market?cat=common" class="tab <%= category==='common'?'active':'' %>">Common</a>
        <a href="/market?cat=drug" class="tab <%= category==='drug'?'active':'' %>">Drug</a>
        <a href="/market?cat=weapon" class="tab <%= category==='weapon'?'active':'' %>">Weapon</a>
        <a href="/market?cat=armor" class="tab <%= category==='armor'?'active':'' %>">Armor</a>
      </div>
      <h3 style="color:#ff6b35;">BUY</h3>
      <div class="grid-2">
        <% items.forEach(i => { %>
          <div class="item-card">
            <div class="name"><%= i.name %> <small class="type"><%= i.type.toUpperCase() %></small></div>
            <div class="stats"><%= i.effect ? '+'+i.value+' '+i.effect.toUpperCase() : '' %> <%= i.str ? 'STR +'+i.str : '' %> <%= i.def ? 'DEF +'+i.def : '' %> <%= i.reqLvl ? '· requires Lvl '+i.reqLvl : '' %></div>
            <div class="price">$<%= i.price %></div>
            <button class="btn btn-small" onclick="buyItem(<%= i.id %>)">BUY</button>
          </div>
        <% }); %>
      </div>
    </main>
  </div>
  <script>function buyItem(id){fetch('/market/buy/'+id,{method:'POST'}).then(r=>r.json()).then(d=>{alert(d.msg);location.reload();});}</script>
</body></html>
