<!DOCTYPE html><html><head><title>Register</title><link rel="stylesheet" href="/css/style.css"></head>
<body class="auth"><div class="box"><h1>New Inmate</h1>
<% if (error) { %><p class="error"><%= error %></p><% } %>
<form method="POST">
<input name="tag" placeholder="Inmate Tag" required>
<input name="email" placeholder="Email" required>
<input name="pass" type="password" placeholder="Passcode" required>
<input name="confirm" type="password" placeholder="Confirm Passcode" required>
<button>Register & Enter</button>
</form></div></body></html>
