<!DOCTYPE html><html><head><title>Crimes</title><link rel="stylesheet" href="/css/style.css"></head>
<body>
  <div class="top-bar"><div class="player-info"><strong><%= user.tag %></strong> (Lvl <%= user.lvl %>)</div><div class="stat-bars"><div class="stat-bar"><span class="label">NRV</span><div class="value"><%= user.nrv %>/<%= user.max_nrv %></div></div></div></div>
  <div class="game-layout">
    <nav class="sidebar">
      <a href="/prison-hall">Prison Hall</a><a href="/crimes" class="active">Crimes</a><a href="/yard">Yard</a><a href="/gym">Gym</a><a href="/jobs">Jobs Board</a><a href="/inmates">All Inmates</a><a href="/hitlist">Hitlist</a><a href="/game-room">Game Room</a><a href="/cell">My Cell</a><a href="/inventory">Inventory</a><a href="/market">Market</a><a href="/bank">Bank</a><a href="/forums">Forums</a><a href="/shoutbox">Shoutbox</a><a href="/directors-office">Director's Office</a><a href="/med-bay">Med Bay</a><a href="/guide">Guide</a><a href="/contact">Contact</a><a href="/logout">Sign Out</a>
    </nav>
    <main class="main-content">
      <h2 style="color:#ff6b35;">CRIMES</h2>
      <p style="color:#a0a0a0;margin-bottom:15px;">Ironhold · <%= location === 'all' ? 'All Locations' : location.replace('_',' ').toUpperCase() %></p>
      <div class="tabs">
        <a href="/crimes?loc=all" class="tab <%= location==='all'?'active':'' %>">All</a>
        <a href="/crimes?loc=main_block" class="tab <%= location==='main_block'?'active':'' %>">Main Block</a>
        <a href="/crimes?loc=yard" class="tab <%= location==='yard'?'active':'' %>">The Yard</a>
        <a href="/crimes?loc=mess_hall" class="tab <%= location==='mess_hall'?'active':'' %>">Mess Hall</a>
        <a href="/crimes?loc=med_bay" class="tab <%= location==='med_bay'?'active':'' %>">Med Bay</a>
        <a href="/crimes?loc=directors_office" class="tab <%= location==='directors_office'?'active':'' %>">Director's Office</a>
      </div>
      <div class="grid-2">
        <% crimes.forEach(c => { %>
          <div class="crime-card">
            <div class="name"><%= c.name %></div>
            <div class="desc"><%= c.desc %></div>
            <div class="stats">
              <div><span>Nerve cost:</span> <strong><%= c.nerve %> NRV</strong></div>
              <div><span>Total Nerve required:</span> <strong><%= c.totalNerve %> NRV</strong></div>
              <div><span>Speed recommended:</span> <strong><%= c.speed %></strong></div>
              <div><span>Payout:</span> <strong>$<%= c.payoutMin %>-<%= c.payoutMax %></strong></div>
              <div><span>Experience:</span> <strong><%= c.expMin %>-<%= c.expMax %> EXP</strong></div>
              <div><span>Odds:</span> <strong style="color:<%= c.odds > 60 ? '#4caf50' : '#ff6b35' %>"><%= c.odds %>%</strong></div>
            </div>
            <button class="btn btn-small" style="margin-top:10px;" onclick="commitCrime(<%= c.id %>)">COMMIT</button>
          </div>
        <% }); %>
      </div>
    </main>
  </div>
  <script>
    function commitCrime(id) {
      fetch('/crime/'+id, {method:'POST'}).then(r=>r.json()).then(d=>{alert(d.msg);location.reload();});
    }
  </script>
</body></html>
