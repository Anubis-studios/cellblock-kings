<!DOCTYPE html>
<html>
<head>
  <title><%= title || 'Cellblock Kings' %></title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" type="image/svg+xml" href="/logos/cellblock-kings-logo.svg">
</head>
<body>
  <div class="top-bar">
    <div class="logo-small">
      <img src="/logos/cellblock-kings-logo.svg" alt="CK" style="height:40px;" onerror="this.style.display='none'">
      <span style="color:#ff6b35; font-weight:bold; font-size:18px; text-transform:uppercase; letter-spacing:2px; margin-left:10px;">CELLBLOCK KINGS</span>
    </div>
    <div class="player-info-top">
      <div class="player-avatar">👤</div>
      <div class="player-details">
        <h2><%= user.tag %></h2>
        <p>Lvl: <%= user.lvl %> | Cash: $<%= user.cash %> | Favors: <%= user.favors || 0 %></p>
      </div>
    </div>
    <div class="stat-bars-top">
      <div class="stat-bar-top"><div class="label">HP</div><div class="value"><%= user.hp %>/<%= user.max_hp %></div><div class="bar"><div class="bar-fill hp-fill" style="width: <%= (user.hp/user.max_hp)*100 %>%"></div></div></div>
      <div class="stat-bar-top"><div class="label">ENR</div><div class="value"><%= user.en %>/<%= user.max_en %></div><div class="bar"><div class="bar-fill en-fill" style="width: <%= (user.en/user.max_en)*100 %>%"></div></div></div>
      <div class="stat-bar-top"><div class="label">STM</div><div class="value"><%= user.stm %>/<%= user.max_stm %></div><div class="bar"><div class="bar-fill stm-fill" style="width: <%= (user.stm/user.max_stm)*100 %>%"></div></div></div>
      <div class="stat-bar-top"><div class="label">NRV</div><div class="value"><%= user.nrv %>/<%= user.max_nrv %></div><div class="bar"><div class="bar-fill nrv-fill" style="width: <%= (user.nrv/user.max_nrv)*100 %>%"></div></div></div>
    </div>
  </div>
  <div class="game-layout">
    <nav class="sidebar">
      <div class="sidebar-section">
        <div class="sidebar-title">MENU</div>
        <a href="/rap-sheet" class="<%= active === 'rap-sheet' ? 'active' : '' %>">My Account</a>
        <a href="/surgeon" class="<%= active === 'surgeon' ? 'active' : '' %>">🔪 The Surgeon</a>
        <a href="/premium" class="<%= active === 'premium' ? 'active' : '' %>">💎 Premium Store</a>
        <a href="/shop" class="<%= active === 'shop' ? 'active' : '' %>">Black Market</a>
        <a href="/prison-jobs" class="<%= active === 'jobs' ? 'active' : '' %>">Jobs Board</a>
        <a href="/npcs" class="<%= active === 'npcs' ? 'active' : '' %>">Inmates</a>
        <a href="/shoutbox" class="<%= active === 'shoutbox' ? 'active' : '' %>">Shoutbox</a>
      </div>
      <div class="sidebar-section">
        <div class="sidebar-title">PRISON</div>
        <a href="/prison-transport" class="<%= active === 'transport' ? 'active' : '' %>">Prison Transport</a>
      </div>
      <div class="sidebar-section">
        <a href="/logout" style="color:#f44336; font-weight:bold;">🚪 Logout</a>
      </div>
      <div class="game-time">Game Time: <span id="gameTime">Loading...</span></div>
    </nav>
    <main class="main-content">
