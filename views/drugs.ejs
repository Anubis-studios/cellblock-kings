<!DOCTYPE html><html><head><title>Black Market Drugs</title><meta name="viewport" content="width=device-width, initial-scale=1.0"><link rel="stylesheet" href="/css/style.css"></head>
<body>
  <%- include('partials/nav') %>
  <main class="mobile-main">
    <h2>💊 Black Market Pharmacy</h2>
    <p class="warning">⚠️ Overdose sends you to the Med Bay for 30 mins!</p>
    <div class="grid">
      <% drugs.forEach(d => { %>
        <div class="card">
          <h3><%= d.name %></h3>
          <p>Buff: +<%= d.buff %> <%= d.effect.toUpperCase() %> (<%= d.duration %>m)</p>
          <p>Risk: <span style="color:<%= d.od_chance > 15 ? '#ff6b35' : '#4caf50' %>"><%= d.od_chance %>%</span></p>
          <p class="price">$<%= d.price %></p>
          <button class="btn-action" onclick="buy(<%= d.id %>)">Buy & Use</button>
        </div>
      <% }) %>
    </div>
  </main>
  <%- include('partials/bottom-nav') %>
  <script>function buy(id){if(!confirm('Risk overdose?'))return;fetch('/drugs/buy/'+id,{method:'POST'}).then(r=>r.json()).then(d=>{alert(d.msg);location.reload();});}</script>
</body></html>
