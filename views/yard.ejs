<!DOCTYPE html>
<html>
<head><title>Yard - Cellblock Kings</title><link rel="stylesheet" href="/css/style.css"></head>
<body>
  <header><h1>🔒 CELLBLOCK KINGS</h1><span><%= user.tag %> (Lvl <%= user.lvl %>)</span></header>
  <nav><a href="/home">Home</a> <a href="/gym">Gym</a> <a href="/market">Market</a> <a href="/inventory">Inventory</a> <a href="/inmates">Inmates</a> <a href="/bank">Bank</a> <a href="/hitlist">Hitlist</a> <a href="/cell">Cell</a> <a href="/jobs">Jobs</a> <a href="/drugs">Drugs</a> <a href="/yard">Yard</a> <a href="/logout" style="color:#ff6b35">Logout</a></nav>
  <main>
    <h2>🌳 Prison Yard</h2>
    <div style="background:#222; padding:15px; border-radius:5px; margin-bottom:20px; text-align:center;">
      <p style="color:#a0a0a0;">Current Position:</p>
      <h3 style="color:#4caf50; font-size:2em; margin:10px 0;">X: <%= user.yard_x %> | Y: <%= user.yard_y %></h3>
      <p style="font-size:0.8em; color:#a0a0a0;">Movement costs 5 Stamina. Digging costs 10 Energy.</p>
    </div>

    <div style="display:grid; grid-template-columns: repeat(3, 1fr); gap:10px; max-width:300px; margin:0 auto 20px auto;">
      <div></div>
      <button class="action-btn" onclick="move('n')">⬆️ N</button>
      <div></div>
      <button class="action-btn" onclick="move('w')">⬅️ W</button>
      <button class="action-btn" style="background:#ff9800;" onclick="dig()">⛏️ DIG</button>
      <button class="action-btn" onclick="move('e')">➡️ E</button>
      <div></div>
      <button class="action-btn" onclick="move('s')">⬇️ S</button>
      <div></div>
    </div>
  </main>
  <script>
    function move(dir) { fetch('/yard/move', { method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({dir}) }).then(r => r.json()).then(d => { alert(d.msg); location.reload(); }); }
    function dig() { fetch('/yard/dig', { method: 'POST' }).then(r => r.json()).then(d => { alert(d.msg); location.reload(); }); }
  </script>
</body>
</html>
