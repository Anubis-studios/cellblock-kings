<!DOCTYPE html>
<html>
<head><title>Bank - Cellblock Kings</title><link rel="stylesheet" href="/css/style.css"></head>
<body>
  <header><h1>🔒 CELLBLOCK KINGS</h1><span><%= user.tag %> (Lvl <%= user.lvl %>)</span></header>
  <nav><a href="/home">Home</a> <a href="/gym">Gym</a> <a href="/market">Market</a> <a href="/inventory">Inventory</a> <a href="/inmates">Inmates</a> <a href="/bank">Bank</a> <a href="/hitlist">Hitlist</a> <a href="/cell">Cell</a> <a href="/logout" style="color:#ff6b35">Logout</a></nav>
  <main>
    <h2>🏦 First National Prison Bank</h2>
    <div class="stats" style="max-width:400px;">
      <div class="stat-box"><span>On Hand</span><strong style="color:#4caf50">$<%= user.cash %></strong></div>
      <div class="stat-box"><span>In Bank</span><strong style="color:#ffd700">$<%= user.bank_balance %></strong></div>
    </div>
    <p style="color:#a0a0a0; margin:15px 0;">Money in the bank is 100% safe from PvP raids and theft!</p>
    
    <div style="display:flex; gap:10px; margin-top:20px;">
      <input type="number" id="bankAmount" placeholder="Amount" style="flex:1;">
      <button class="action-btn" onclick="bankAction('deposit')" style="flex:1; background:#4caf50;">Deposit</button>
      <button class="action-btn" onclick="bankAction('withdraw')" style="flex:1; background:#2196f3;">Withdraw</button>
    </div>
  </main>
  <script>
    function bankAction(type) {
      const amount = document.getElementById('bankAmount').value;
      if (!amount) return alert('Enter an amount!');
      fetch('/bank/' + type, { method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({amount}) })
        .then(r => r.json()).then(d => { alert(d.msg); location.reload(); });
    }
  </script>
</body>
</html>
