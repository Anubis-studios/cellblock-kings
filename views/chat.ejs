<!DOCTYPE html>
<html>
<head>
  <title>Shoutbox</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/nav') %>
  <main class="mobile-main">
    <h2>💬 Prison Shoutbox</h2>
    <form method="POST" style="display:flex; gap:10px; margin-bottom:20px;">
      <input name="msg" placeholder="Say something..." style="flex:1;" required>
      <button class="btn-primary" style="width:auto;">Shout</button>
    </form>
    <div class="list">
      <% messages.forEach(function(m) { %>
        <div class="card-row">
          <div>
            <h4 style="color:#ff6b35; margin-bottom:5px;"><%= m.tag %></h4>
            <p><%= m.msg %></p>
          </div>
        </div>
      <% }); %>
    </div>
  </main>
  <%- include('partials/bottom-nav') %>
</body>
</html>
