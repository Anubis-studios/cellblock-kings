<%- include('layout-header', { title: 'Prison Yard', active: 'explore' }) %>
<div style="background:#1a1a1a;border:2px solid #555;padding:20px;margin-bottom:15px;">
  <h2 style="color:#fff;margin-bottom:10px;">Prison Yard</h2>
  <div style="background:linear-gradient(180deg,#4a6f4a 0%,#2a4f2a 100%);height:300px;position:relative;border:2px solid #555;overflow:hidden;">
    <div style="position:absolute;top:0;left:0;right:0;height:50px;background:#6a6a6a;"></div>
    <div style="position:absolute;top:50px;left:0;right:0;bottom:0;background:#4a6f4a;"></div>
    <div style="position:absolute;top:100px;left:100px;width:200px;height:150px;background:#8a8a8a;border:2px solid #666;"></div>
    <div style="position:absolute;bottom:20px;left:50%;transform:translateX(-50%);background:#2a2a2a;padding:10px;border:1px solid #555;max-width:80%;">
      <p style="color:#aaa;font-size:11px;">The air is fresher out here, and there's more breathing room for sure. Though, there's still the faint odor of sweat, deceit and cunning about... and the fence is tall... real tall.</p>
    </div>
  </div>
</div>
