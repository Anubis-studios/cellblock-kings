<!DOCTYPE html>
<html>
<head>
  <title><%= title || 'Cellblock Kings' %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="top-bar">
    <div class="player-info-top">
      <div class="player-avatar">👤</div>
      <div class="player-details">
        <h2><%= user.tag %></h2>
        <p>Lvl: <%= user.lvl %> | Cash: $<%= user.cash %> | Points: <%= user.points || 0 %></p>
      </div>
    </div>
    <div class="stat-bars-top">
      <div class="stat-bar-top"><div class="label">HP</div><div class="value"><%= user.hp %>/<%= user.max_hp %></div><div class="bar"><div class="bar-fill hp-fill" style="width: <%= (user.hp/user.max_hp)*100 %>%"></div></div></div>
      <div class="stat-bar-top"><div class="label">ENR</div><div class="value"><%= user.en %>/<%= user.max_en %></div><div class="bar"><div class="bar-fill en-fill" style="width: <%= (user.en/user.max_en)*100 %>%"></div></div></div>
      <div class="stat-bar-top"><div class="label">STM</div><div class="value"><%= user.stm %>/<%= user.max_stm %></div><div class="bar"><div class="bar-fill stm-fill" style="width: <%= (user.stm/user.max_stm)*100 %>%"></div></div></div>
      <div class="stat-bar-top"><div class="label">NRV</div><div class="value"><%= user.nrv %>/<%= user.max_nrv %></div><div class="bar"><div class="bar-fill nrv-fill" style="width: <%= (user.nrv/user.max_nrv)*100 %>%"></div></div></div>
      <div class="stat-bar-top"><div class="label">EXP</div><div class="value"><%= user.exp %></div><div class="bar"><div class="bar-fill exp-fill" style="width: <%= Math.min((user.exp/(user.lvl*100))*100, 100) %>%"></div></div></div>
    </div>
  </div>
  <div class="game-layout">
    <nav class="sidebar">
      <div class="mail-icons">
        <div class="mail-icon" onclick="location.href='/mail'">📧 Mail</div>
        <div class="mail-icon">📝 Events</div>
      </div>
      <div class="sidebar-section">
        <div class="sidebar-title">MENU</div>
        <a href="/rap-sheet" class="<%= active === 'rap-sheet' ? 'active' : '' %>">My Account</a>
        <a href="/my-cell" class="<%= active === 'my-cell' ? 'active' : '' %>">My Cell</a>
        <a href="/bank" class="<%= active === 'bank' ? 'active' : '' %>">My Bank Account</a>
        <a href="/equipment" class="<%= active === 'equipment' ? 'active' : '' %>">My Equipment</a>
        <a href="/inventory" class="<%= active === 'inventory' ? 'active' : '' %>">My Inventory</a>
        <a href="/missions" class="<%= active === 'missions' ? 'active' : '' %>">My Missions</a>
        <a href="/battles" class="<%= active === 'battles' ? 'active' : '' %>">Battles</a>
        <a href="/spy-log" class="<%= active === 'spy-log' ? 'active' : '' %>">Spy Log</a>
        <a href="/friends" class="<%= active === 'friends' ? 'active' : '' %>">Friends</a>
        <a href="/enemies" class="<%= active === 'enemies' ? 'active' : '' %>">Enemies</a>
        <a href="/rules" class="<%= active === 'rules' ? 'active' : '' %>">Game Rules</a>
      </div>
      <div class="sidebar-section">
        <div class="sidebar-title">PRISON</div>
        <a href="/explore-prison" class="<%= active === 'explore' ? 'active' : '' %>">Explore Prison</a>
        <a href="/gym" class="<%= active === 'gym' ? 'active' : '' %>">The Gym</a>
        <a href="/infirmary" class="<%= active === 'infirmary' ? 'active' : '' %>">Infirmary</a>
        <a href="/infirmary/isolation" class="<%= active === 'isolation' ? 'active' : '' %>">Isolation Cell</a>
        <a href="/marketplace" class="<%= active === 'marketplace' ? 'active' : '' %>">Marketplace</a>
        <a href="/game-room" class="<%= active === 'game-room' ? 'active' : '' %>">Game Room</a>
        <a href="/hitlist" class="<%= active === 'hitlist' ? 'active' : '' %>">The Hitlist</a>
        <a href="/warden" class="<%= active === 'warden' ? 'active' : '' %>">The Warden</a>
        <a href="/prison-transport" class="<%= active === 'transport' ? 'active' : '' %>">Prison Transport</a>
        <a href="/most-wanted" class="<%= active === 'most-wanted' ? 'active' : '' %>">Most Wanted List</a>
        <a href="/lottery" class="<%= active === 'lottery' ? 'active' : '' %>">Weekly Lottery</a>
        <a href="/tutorial" class="<%= active === 'tutorial' ? 'active' : '' %>">Game Tutorial</a>
        <a href="/shoutbox" class="<%= active === 'shoutbox' ? 'active' : '' %>">Shoutbox</a>
      </div>
      <div class="sidebar-section">
        <div class="sidebar-title">GANGS</div>
        <a href="/gangs" class="<%= active === 'gangs' ? 'active' : '' %>">Known Gangs</a>
        <a href="/gangs/invites">Gang Invites</a>
      </div>
      <div class="sidebar-section">
        <div class="sidebar-title">VOTING LINKS</div>
        <a href="/voting">OZ Games</a>
        <a href="/voting">GTop 100</a>
        <a href="/voting">MMOG</a>
        <a href="/voting">Top Web Games</a>
        <a href="/voting">Top 100 Arena</a>
      </div>
      <div class="game-time">Game Time: <span id="gameTime">Loading...</span></div>
    </nav>
    <main class="main-content">
