<!DOCTYPE html>
<html>
<head><title>Jobs - Cellblock Kings</title><link rel="stylesheet" href="/css/style.css"></head>
<body>
  <header><h1>🔒 CELLBLOCK KINGS</h1><span><%= user.tag %> (Lvl <%= user.lvl %>)</span></header>
  <nav><a href="/home">Home</a> <a href="/gym">Gym</a> <a href="/market">Market</a> <a href="/inventory">Inventory</a> <a href="/inmates">Inmates</a> <a href="/bank">Bank</a> <a href="/hitlist">Hitlist</a> <a href="/cell">Cell</a> <a href="/jobs">Jobs</a> <a href="/drugs">Drugs</a> <a href="/yard">Yard</a> <a href="/logout" style="color:#ff6b35">Logout</a></nav>
  <main>
    <h2>💼 Prison Jobs</h2>
    <p style="color:#a0a0a0; margin-bottom:15px;">Spend Energy to earn guaranteed cash. Higher level jobs pay more!</p>
    <div class="inmates-list">
      <% jobs.forEach(job => { %>
        <div class="inmate-card">
          <div class="inmate-info">
            <h4><%= job.name %> <span style="color:#a0a0a0; font-size:0.8em;">(Req: Lvl <%= job.req_lvl %>)</span></h4>
            <p style="font-size:0.8em; color:#a0a0a0;">Cost: <%= job.energy_cost %> Energy | Pay: $<%= job.pay_min %> - $<%= job.pay_max %></p>
          </div>
          <button class="attack-btn" style="background:#4caf50;" onclick="work(<%= job.id %>)">Work</button>
        </div>
      <% }) %>
    </div>
  </main>
  <script>
    function work(id) { fetch('/work/'+id, {method:'POST'}).then(r=>r.json()).then(d=>{alert(d.msg); location.reload();}); }
  </script>
</body>
</html>
