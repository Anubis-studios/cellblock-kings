<!DOCTYPE html><html><head><title>Inventory</title><link rel="stylesheet" href="/css/style.css"></head>
<body>
  <div class="top-bar"><div class="player-info"><strong><%= user.tag %></strong></div><div class="stat-bars"><div class="stat-bar"><span class="label">CASH</span><div class="value">$<%= user.cash %></div></div></div></div>
  <div class="game-layout">
    <nav class="sidebar"><a href="/prison-hall">Prison Hall</a><a href="/cell">My Cell</a><a href="/inventory" class="active">Inventory</a><a href="/market">Market</a><a href="/logout">Sign Out</a></nav>
    <main class="main-content">
      <h2 style="color:#ff6b35;">INVENTORY</h2>
      <p style="color:#a0a0a0;margin-bottom:20px;">Use · Sell · Send to a friend in the same prison</p>
      <h3 style="color:#ff6b35;">EQUIPPED</h3>
      <div class="grid-2" style="margin-bottom:20px;">
        <div class="card"><strong>WEAPON</strong><br><small style="color:#a0a0a0;">Nothing equipped</small><br><button class="btn btn-small">EQUIP</button></div>
        <div class="card"><strong>ARMOR</strong><br><small style="color:#a0a0a0;">Nothing but jumpsuit</small></div>
      </div>
      <h3 style="color:#ff6b35;">STASH</h3>
      <% if (inv.length === 0) { %><p style="color:#a0a0a0;">Empty. Visit the Market.</p><% } else { %>
        <div class="grid-2">
          <% inv.forEach(i => { %>
            <div class="item-card">
              <div class="name"><%= i.name %> <%= i.qty > 1 ? '×'+i.qty : '' %></div>
              <div class="stats"><%= i.effect ? '+'+i.value+' '+i.effect.toUpperCase() : '' %> <%= i.str ? 'STR +'+i.str : '' %> <%= i.def ? 'DEF +'+i.def : '' %></div>
              <div style="display:flex;gap:5px;margin-top:5px;">
                <button class="btn btn-small" onclick="useItem('<%= i._id %>')">USE</button>
                <button class="btn btn-secondary btn-small" onclick="sellItem('<%= i._id %>')">SELL</button>
              </div>
            </div>
          <% }); %>
        </div>
      <% } %>
    </main>
  </div>
  <script>
    function useItem(id){fetch('/inventory/use/'+id,{method:'POST'}).then(r=>r.json()).then(d=>{alert(d.msg);location.reload();});}
    function sellItem(id){fetch('/inventory/sell/'+id,{method:'POST'}).then(r=>r.json()).then(d=>{alert(d.msg);location.reload();});}
  </script>
</body></html>
