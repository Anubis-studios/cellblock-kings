<!DOCTYPE html><html><head><title>My Cell</title><link rel="stylesheet" href="/css/style.css"></head>
<body>
  <div class="top-bar"><div class="player-info"><strong><%= user.tag %></strong></div></div>
  <div class="game-layout">
    <nav class="sidebar"><a href="/prison-hall">Prison Hall</a><a href="/cell" class="active">My Cell</a><a href="/inventory">Inventory</a><a href="/market">Market</a><a href="/logout">Sign Out</a></nav>
    <main class="main-content">
      <h2 style="color:#ff6b35;">MY CELL</h2>
      <p style="color:#a0a0a0;margin-bottom:20px;">7×6 grid · amenities stack additively on base stats</p>
      <div class="yard-grid" style="margin-bottom:20px;">
        <% for (let i = 0; i < 42; i++) { %><div class="yard-cell"></div><% } %>
      </div>
      <div style="display:flex;gap:10px;margin-bottom:20px;">
        <button class="btn btn-secondary">SAVE PRESET</button>
        <button class="btn btn-secondary">CLEAR CELL</button>
        <button class="btn btn-secondary">RANDOM CELL LAYOUT 0-RESET</button>
      </div>
      <h3 style="color:#ff6b35;">OWNED AMENITIES</h3>
      <p style="color:#a0a0a0;">No amenities yet. The Director sells them, or steal one in a raid.</p>
      <h3 style="color:#ff6b35;margin-top:20px;">PRESETS</h3>
      <p style="color:#a0a0a0;">No saved layouts.</p>
    </main>
  </div>
</body></html>
