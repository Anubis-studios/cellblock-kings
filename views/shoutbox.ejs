<%- include('layout-header', { title: 'Shoutbox', active: 'shoutbox' }) %>
<div class="content-box">
  <h3>Shoutbox</h3>
  <p style="color:#666;font-size:11px;margin-bottom:15px;">Global chat · keep it clean, keep it legal</p>
  <div style="background:#1a1a1a;border:1px solid #555;padding:15px;max-height:400px;overflow-y:auto;margin-bottom:15px;">
    <% messages.forEach(m => { %>
      <div style="border-bottom:1px solid #333;padding:8px 0;">
        <span style="color:#4caf50;font-weight:bold;"><%= m.user %></span>
        <span style="color:#666;font-size:10px;float:right;"><%= new Date(m.time).toLocaleTimeString() %></span>
        <p style="color:#fff;margin-top:5px;"><%= m.msg %></p>
      </div>
    <% }); %>
  </div>
  <form method="POST" style="display:flex;gap:10px;">
    <input name="msg" placeholder="Say something..." style="flex:1;" required>
    <button class="btn btn-primary">SHOUT</button>
  </form>
</div>
<%- include('layout-footer') %>
