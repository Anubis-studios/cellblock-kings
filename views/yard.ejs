<!DOCTYPE html><html><head><title>Yard</title><link rel="stylesheet" href="/css/style.css"></head>
<body>
  <div class="top-bar"><div class="player-info"><strong><%= user.tag %></strong></div><div class="stat-bars"><div class="stat-bar"><span class="label">STM</span><div class="value"><%= user.stm %>/<%= user.max_stm %></div></div></div></div>
  <div class="game-layout">
    <nav class="sidebar"><a href="/prison-hall">Prison Hall</a><a href="/crimes">Crimes</a><a href="/yard" class="active">Yard</a><a href="/gym">Gym</a><a href="/jobs">Jobs Board</a><a href="/inmates">All Inmates</a><a href="/inventory">Inventory</a><a href="/market">Market</a><a href="/logout">Sign Out</a></nav>
    <main class="main-content">
      <h2 style="color:#ff6b35;">THE YARD - IRONHOLD</h2>
      <p style="color:#a0a0a0;margin-bottom:15px;">7×6 grid · diagonal costs 2 STM · position <%= user.yard_x || 0 %>,<%= user.yard_y || 0 %></p>
      <div style="display:flex;gap:20px;align-items:flex-start;">
        <div class="yard-grid" id="yardGrid"></div>
        <div>
          <button class="btn" onclick="move('up')">⬆️ Up</button><br>
          <button class="btn" onclick="move('left')">⬅️ Left</button>
          <button class="btn" onclick="move('right')">➡️ Right</button><br>
          <button class="btn" onclick="move('down')">⬇️ Down</button>
          <br><br>
          <button class="btn btn-secondary">Pick Up / Empty Pockets</button>
        </div>
      </div>
    </main>
  </div>
  <script>
    const x = <%= user.yard_x || 0 %>, y = <%= user.yard_y || 0 %>;
    const grid = document.getElementById('yardGrid');
    for (let row = 0; row < 6; row++) {
      for (let col = 0; col < 7; col++) {
        const cell = document.createElement('div');
        cell.className = 'yard-cell' + (col === x && row === y ? ' player' : '');
        cell.textContent = (col === x && row === y) ? '👤' : '';
        grid.appendChild(cell);
      }
    }
    function move(dir) { fetch('/yard/move',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({dir})}).then(r=>r.json()).then(d=>{alert(d.msg);location.reload();}); }
  </script>
</body></html>
