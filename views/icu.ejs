<%- include('layout-header', { title: 'ICU', active: 'infirmary' }) %>
<div class="content-box">
  <h3>Intensive Care Unit</h3>
  <p style="color:#666;font-size:11px;margin-bottom:15px;">Here is a list of the prisoners currently in the I.C.U.:</p>
  <% if (patients.length === 0) { %>
    <p style="color:#888;text-align:center;">No patients currently in ICU.</p>
  <% } else { %>
    <% patients.forEach(p => { %>
      <div style="background:#2a2a2a;border:1px solid #555;padding:10px;margin-bottom:10px;display:flex;align-items:center;gap:10px;">
        <div style="width:40px;height:40px;background:#555;display:flex;align-items:center;justify-content:center;">👤</div>
        <div style="flex:1;">
          <p style="color:#fff;font-weight:bold;"><%= p.tag %> [<%= p.lvl %>]</p>
          <p style="color:#aaa;font-size:11px;"><%= Math.ceil((p.hospitalized_until - Date.now()) / 60000) %> minutes, <%= Math.floor(((p.hospitalized_until - Date.now()) / 60000) % 60) %> seconds</p>
          <p style="color:#888;font-size:10px;">Got mugged and beat down by <%= p.mugged_by || 'Unknown' %></p>
        </div>
      </div>
    <% }); %>
  <% } %>
  <div style="text-align:right;"><button class="btn btn-small" onclick="location.href='/infirmary'">back to infirmary</button></div>
</div>
<%- include('layout-footer') %>
