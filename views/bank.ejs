<!DOCTYPE html><html><head><title>Bank</title><link rel="stylesheet" href="/css/style.css"></head>
<body>
  <div class="top-bar"><div class="player-info"><strong><%= user.tag %></strong></div></div>
  <div class="game-layout">
    <nav class="sidebar"><a href="/prison-hall">Prison Hall</a><a href="/market">Market</a><a href="/bank" class="active">Bank</a><a href="/logout">Sign Out</a></nav>
    <main class="main-content">
      <h2 style="color:#ff6b35;">BANK - IRONHOLD</h2>
      <p style="color:#a0a0a0;margin-bottom:20px;">Deposits are level-capped. Balance is lost on transfer.</p>
      <% if (!account) { %>
        <div class="card">
          <p>No account here yet. Opening costs $2,500.</p>
          <button class="btn" onclick="openAccount()">OPEN ACCOUNT</button>
        </div>
      <% } else { %>
        <div class="card">
          <p>Balance: <strong style="color:#4caf50;">$<%= account.balance %></strong></p>
          <div style="display:flex;gap:10px;margin-top:10px;">
            <input type="number" id="amt" placeholder="Amount" style="flex:1;">
            <button class="btn" onclick="deposit()">DEPOSIT</button>
            <button class="btn btn-secondary" onclick="withdraw()">WITHDRAW</button>
          </div>
        </div>
      <% } %>
    </main>
  </div>
  <script>
    function openAccount(){fetch('/bank/open',{method:'POST'}).then(r=>r.json()).then(d=>{alert(d.msg);location.reload();});}
    function deposit(){const a=document.getElementById('amt').value;if(!a)return;fetch('/bank/deposit',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({amount:parseInt(a)})}).then(r=>r.json()).then(d=>{alert(d.msg);location.reload();});}
    function withdraw(){const a=document.getElementById('amt').value;if(!a)return;fetch('/bank/withdraw',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({amount:parseInt(a)})}).then(r=>r.json()).then(d=>{alert(d.msg);location.reload();});}
  </script>
</body></html>
