<%- include('layout-header', { title: 'My Account', active: 'rap-sheet' }) %>
<div class="tabs">
  <button class="tab" onclick="location.href='/rap-sheet'">Rap Sheet</button>
  <button class="tab active">My Account</button>
  <button class="tab" onclick="location.href='/profile'">Profile</button>
  <button class="tab" onclick="location.href='/referrals'">Referrals</button>
  <button class="tab" onclick="location.href='/transactions'">Transactions</button>
  <button class="tab" onclick="location.href='/notes'">Notes</button>
</div>
<div class="content-box">
  <h3>My Account</h3>
  <div class="stats-grid">
    <div class="stat-row"><span class="label">Username:</span><span class="value"><%= user.tag %></span></div>
    <div class="stat-row"><span class="label">Email:</span><span class="value"><%= user.email %></span></div>
    <div class="stat-row"><span class="label">Member Since:</span><span class="value"><%= new Date(user.created).toLocaleDateString() %></span></div>
    <div class="stat-row"><span class="label">Account Status:</span><span class="value" style="color:#4caf50;">Active</span></div>
  </div>
</div>
<%- include('layout-footer') %>
