<!DOCTYPE html><html><head><title>Jobs Board</title><link rel="stylesheet" href="/css/style.css"></head>
<body>
  <div class="top-bar"><div class="player-info"><strong><%= user.tag %></strong></div></div>
  <div class="game-layout">
    <nav class="sidebar"><a href="/prison-hall">Prison Hall</a><a href="/crimes">Crimes</a><a href="/yard">Yard</a><a href="/gym">Gym</a><a href="/jobs" class="active">Jobs Board</a><a href="/inmates">All Inmates</a><a href="/inventory">Inventory</a><a href="/logout">Sign Out</a></nav>
    <main class="main-content">
      <h2 style="color:#ff6b35;">JOBS BOARD - IRONHOLD</h2>
      <p style="color:#a0a0a0;margin-bottom:20px;">Stat-gated · pay lands in the bank once a day</p>
      <% jobs.forEach(j => { %>
        <div class="card">
          <h3><%= j.name %></h3>
          <p>Requires <%= j.reqVal %> <%= j.reqStat.toUpperCase() %> (you have <%= user[j.reqStat] %>) · $<%= j.pay %> / day</p>
          <button class="btn" <%= !j.hasReq || j.claimed ? 'disabled' : '' %> onclick="claim(<%= j.id %>)"><%= j.claimed ? 'CLAIMED' : (j.hasReq ? 'CLAIM THE JOB' : 'STATS TOO LOW') %></button>
        </div>
      <% }); %>
    </main>
  </div>
  <script>function claim(id){fetch('/jobs/claim/'+id,{method:'POST'}).then(r=>r.json()).then(d=>{alert(d.msg);location.reload();});}</script>
</body></html>
