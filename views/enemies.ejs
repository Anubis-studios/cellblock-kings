<%- include('layout-header', { title: 'Enemies', active: 'enemies' }) %>
<div class="tabs">
  <button class="tab" onclick="location.href='/friends'">My Friends</button>
  <button class="tab active">My Enemies</button>
  <button class="tab" onclick="location.href='/mail'">My Blocklist</button>
  <button class="tab" onclick="location.href='/hitlist'">My Hits</button>
</div>
<div class="content-box">
  <h3>My Enemies</h3>
  <% if (!user.enemies || user.enemies.length === 0) { %>
    <p style="color:#888;text-align:center;">No enemies? Who the fuck are you? Mary Poppins?</p>
  <% } else { %>
    <% user.enemies.forEach(e => { %>
      <div style="background:#2a2a2a;border:1px solid #f44336;padding:10px;margin-bottom:10px;">
        <p style="color:#f44336;font-weight:bold;"><%= e %></p>
      </div>
    <% }); %>
  <% } %>
  <div style="margin-top:15px;">
    <input type="text" placeholder="Add enemy by tag" id="enemyTag">
    <button class="btn btn-danger" onclick="addEnemy()">Add Enemy</button>
  </div>
</div>
<script>function addEnemy(){const tag=document.getElementById('enemyTag').value;if(!tag)return;fetch('/enemies/add',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({tag})}).then(r=>r.json()).then(d=>{alert(d.msg);location.reload();});}</script>
<%- include('layout-footer') %>
