<%- include('layout-header', { title: 'Mail', active: 'mail' }) %>
<div class="tabs">
  <button class="tab active">Inbox</button>
  <button class="tab">Outbox</button>
  <button class="tab">Mail Settings</button>
</div>
<div class="content-box">
  <h3>My Mail</h3>
  <% if (!user.mail || !user.mail.inbox || user.mail.inbox.length === 0) { %>
    <p style="color:#888;text-align:center;">You have no mail.</p>
  <% } else { %>
    <% user.mail.inbox.forEach(m => { %>
      <div style="background:#2a2a2a;border:1px solid #555;padding:10px;margin-bottom:10px;">
        <p style="color:#4caf50;font-weight:bold;">From: <%= m.from %></p>
        <p style="color:#1a1a1a;"><%= m.subject %></p>
        <p style="color:#666;font-size:11px;"><%= m.message %></p>
        <p style="color:#888;font-size:10px;"><%= new Date(m.date).toLocaleString() %></p>
      </div>
    <% }); %>
  <% } %>
</div>
<%- include('layout-footer') %>
